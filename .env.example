# Configuracion de Auth0
AUTH0_DOMAIN=tu-inquilino.us.auth0.com
AUTH0_CLIENT_ID=tu_client_id_publico
AUTH0_CLIENT_SECRET=tu_client_secret_privado

# URL base de la aplicacion (sin barra final)
APP_BASE_URL=http://localhost:3000

# Secreto para sesiones de Express
SESSION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Cadena de conexion a Supabase Vault (se usara en el Paso 5)
# Direct IPv6:
# VAULT_DATABASE_URL=postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session Pooler IPv4:
# VAULT_DATABASE_URL=postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
